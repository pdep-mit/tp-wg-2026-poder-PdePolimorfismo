import wollok.game.*
import patio.*
import planta.*
import cartaPlanta.*
import habilidades.*
import zoombie.*
import rinoZoombie.*
import jirafaZoombie.*
import osoZoombie.*

describe "Comportamiento de los zoombies" {

    test "Un pinguino avanza una casilla cuando no tiene una planta adelante" {
        const pinguino = new Mono(position = game.at(6, 2))

        pinguino.actuar()

        assert.equals(game.at(5, 2), pinguino.position())
    }

    test "El estado del pinguino caminando avanza si no tiene una planta adelante" {
        const pinguino = new Zoombie(
            position = game.at(6, 2),
            habilidad = comer,
            daño = 80,
            vida = 150,
            velocidadDeMovimiento = 3500,
            estado = pinguinoCaminando,
            imagen = pinguinoCaminando.imagen()
        )

        pinguinoCaminando.actuar(pinguino)

        assert.equals(game.at(5, 2), pinguino.position())
    }

    test "Un rinoceronte buscando avanza una casilla si no encuentra plantas" {
        const rinoceronte = new Rinoceronte(position = game.at(6, 3))

        rinoceronte.actuar()

        assert.equals(game.at(5, 3), rinoceronte.position())
        assert.equals("rinoCaminando.png", rinoceronte.image())
    }

    test "La embestida daña la planta alcanzada y aturde al rinoceronte" {
        const rinoceronte = new Rinoceronte(position = game.at(6, 4))
        const nuez = cartaNuez.crearPlanta(game.at(5, 4))
        patio.agregarPlanta(nuez)

        rinoCargando.actuar(rinoceronte)

        assert.equals(game.at(5, 4), rinoceronte.position())
        assert.notThat(nuez.estaVivo())
        assert.equals("rinoAturdido.png", rinoceronte.image())
    }

    test "La embestida cuadruplica la velocidad y luego recupera el intervalo normal" {
        const rinoceronte = new Rinoceronte(position = game.at(8, 5))
        const nuez = cartaNuez.crearPlanta(game.at(7, 5))
        patio.agregarPlanta(nuez)

        rinoceronte.iniciarEmbestida()

        rinoceronte.pasarTiempo(874)
        assert.equals(game.at(8, 5), rinoceronte.position())

        rinoceronte.pasarTiempo(1)
        assert.equals(game.at(7, 5), rinoceronte.position())
        assert.equals("rinoAturdido.png", rinoceronte.image())

        rinoceronte.volverACaminar()
        rinoceronte.pasarTiempo(3499)
        assert.equals(game.at(7, 5), rinoceronte.position())

        rinoceronte.pasarTiempo(1)
        assert.equals(game.at(6, 5), rinoceronte.position())
    }

    test "El mono maquinista genera un pinguino robot al comenzar la produccion" {
        const maquinista = new MonoMaquinista(position = game.at(10, 2))
        const cantidadInicial = patio.cantidadDeZoombies()

        maquinista.iniciarProduccion()
        maquinista.pasarTiempo(17999)
        assert.equals(cantidadInicial, patio.cantidadDeZoombies())

        maquinista.pasarTiempo(1)
        assert.equals(cantidadInicial + 1, patio.cantidadDeZoombies())
    }

    test "La jirafa cambia de imagen al aplastar exactamente dos plantas" {
        const jirafa = new Jirafa(position = game.at(8, 3))
        const nuezCercana = cartaNuez.crearPlanta(game.at(7, 3))
        const nuezLejana = cartaNuez.crearPlanta(game.at(6, 3))
        patio.agregarPlanta(nuezCercana)
        patio.agregarPlanta(nuezLejana)

        jirafa.actuar()
        assert.equals("jirafaPreparada.png", jirafa.image())

        jirafa.ejecutarAtaqueEspecial()
        assert.equals("jirafaAplastando.png", jirafa.image())
        assert.notThat(nuezCercana.estaVivo())
        assert.notThat(nuezLejana.estaVivo())
    }

    test "La jirafa come una sola planta en su casilla sin iniciar el aplastamiento" {
        const jirafa = new Jirafa(position = game.at(8, 3))
        const nuez = new Planta(habilidad = sinAtaque, daño = 0, vida = 100, position = game.at(8, 3), imagen = "nuez.png")
        patio.agregarPlanta(nuez)

        jirafa.actuar()

        assert.notThat(nuez.estaVivo())
        assert.equals("jirafaZoombi.png", jirafa.image())
    }

    test "El oso muestra preparación y aplastamiento antes de volver a caminar" {
        const oso = new Oso(position = game.at(8, 3))
        const nuez = cartaNuez.crearPlanta(game.at(8, 3))
        patio.agregarPlanta(nuez)

        oso.actuar()
        assert.equals("osoPreparado.png", oso.image())

        oso.ejecutarAplastar()
        assert.equals("osoAplastando.png", oso.image())
        assert.notThat(nuez.estaVivo())

        oso.volverACaminar()
        assert.equals("osoCaminando.png", oso.image())
    }
}

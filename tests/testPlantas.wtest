import planta.*
import zoombie.*
import wollok.game.*
import patio.*
import cursor.*
import pala.*
import jugador.*
import soles.*
import movimientos.*

describe "Comportamiento de las plantas" {

    test "El girasol produce un sol al actuar" {
        const posicion = game.at(4, 1)
        const girasol = new Girasol(position = posicion)

        girasol.actuar()

        assert.that(patio.haySolEnCasilla(posicion))
        patio.solEnCasilla(posicion).desaparecer()
    }

    test "El lanzaguisantes crea un proyectil si hay un zombie delante" {
        const lanzaguisantes = new Lanzaguisantes(position = game.at(4, 2))
        const zombie = new Pinguino(position = game.at(6, 2))
        patio.agregarZoombie(zombie)

        lanzaguisantes.actuar()

        assert.that(patio.proyectiles().any({
            proyectil => proyectil.plantaQueLoDispara() == lanzaguisantes
        }))

        patio.proyectiles()
            .filter({ proyectil => proyectil.plantaQueLoDispara() == lanzaguisantes })
            .forEach({ proyectil => proyectil.desaparecer() })
        patio.quitarZoombie(zombie)
    }

    test "BonkChoi daña al zombie en la casilla de adelante" {
        const bonkChoi = new BonkChoi(position = game.at(4, 3))
        const zombie = new Pinguino(position = game.at(5, 3), vida = 30)
        patio.agregarZoombie(zombie)

        bonkChoi.actuar()

        assert.notThat(zombie.estaVivo())
        patio.quitarZoombie(zombie)
    }

    test "BonkChoi daña a los zombies en la casilla actual, adelante y atrás" {
        const bonkChoi = new BonkChoi(position = game.at(4, 2))
        const zombieActual = new Pinguino(position = bonkChoi.position(), vida = 30)
        const zombieDelante = new Pinguino(position = derecha.desde(bonkChoi.position()), vida = 30)
        const zombieDetras = new Pinguino(position = izquierda.desde(bonkChoi.position()), vida = 30)

        patio.agregarZoombie(zombieActual)
        patio.agregarZoombie(zombieDelante)
        patio.agregarZoombie(zombieDetras)

        bonkChoi.actuar()

        assert.notThat(zombieActual.estaVivo())
        assert.notThat(zombieDelante.estaVivo())
        assert.notThat(zombieDetras.estaVivo())

        patio.quitarZoombie(zombieActual)
        patio.quitarZoombie(zombieDelante)
        patio.quitarZoombie(zombieDetras)
    }

    test "La nuez pierde vida al recibir daño y sigue viva si le queda vida" {
        const nuez = new Nuez(position = game.at(4, 4))

        nuez.recibirDanio(1000)

        assert.that(nuez.estaVivo())

        nuez.recibirDanio(3000)

        assert.notThat(nuez.estaVivo())
    }

    test "Distintas plantas responden polimorficamente al mensaje actuar" {
        const girasol = new Girasol(position = game.at(4, 1))
        const lanzaguisantes = new Lanzaguisantes(position = game.at(4, 2))
        const bonkChoi = new BonkChoi(position = game.at(4, 3))
        const zombieParaDisparo = new Pinguino(position = game.at(6, 2))
        const zombieParaGolpe = new Pinguino(position = game.at(5, 3), vida = 30)
        const plantas = [girasol, lanzaguisantes, bonkChoi]

        patio.agregarZoombie(zombieParaDisparo)
        patio.agregarZoombie(zombieParaGolpe)
        plantas.forEach({ planta => planta.actuar() })

        assert.that(patio.haySolEnCasilla(girasol.position()))
        assert.that(patio.proyectiles().any({
            proyectil => proyectil.plantaQueLoDispara() == lanzaguisantes
        }))
        assert.notThat(zombieParaGolpe.estaVivo())

        patio.solEnCasilla(girasol.position()).desaparecer()
        patio.proyectiles()
            .filter({ proyectil => proyectil.plantaQueLoDispara() == lanzaguisantes })
            .forEach({ proyectil => proyectil.desaparecer() })
        patio.quitarZoombie(zombieParaDisparo)
    }

    test "El jugador delega accionar a la herramienta equipada" {
        const posicionOriginal = jugador.position()
        const posicion = game.at(4, 5)
        jugador.position(posicion)

        const nuez = new Nuez(position = posicion)
        patio.agregarPlanta(nuez)
        jugador.equipar(pala)
        jugador.accionar()

        assert.notThat(patio.hayPlantaEnCasilla(posicion))

        const solesAntes = contadorDeSoles.cantidad()
        const sol = new Sol(position = posicion)
        patio.agregarSol(sol)
        sol.aparecer()
        jugador.equipar(cursor)
        jugador.accionar()

        assert.notThat(patio.haySolEnCasilla(posicion))
        assert.equals(solesAntes + sol.valor(), contadorDeSoles.cantidad())

        jugador.equipar(cursor)
        jugador.position(posicionOriginal)
    }
}
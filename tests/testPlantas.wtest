describe "Tests del contador de soles" {
  test "El contador arranca en un valor inicial de 50 soles" {
    assert.equals(50, contadorDeSoles.solesAhora())
  }

  test "El contador acumula correctamente" {
    contadorDeSoles.acumularSoles(25)
    assert.equals(75, contadorDeSoles.solesAhora())
  }


  test "El contador descuenta los soles correctamente" {
    contadorDeSoles.acumularSoles(125)
    contadorDeSoles.gastarSoles(50)
    assert.equals(125, contadorDeSoles.solesAhora())
  }
}



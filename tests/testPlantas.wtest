import planta.*
import cartaPlanta.*
import zoombie.*
import wollok.game.*
import patio.*
import cursor.*
import pala.*
import jugador.*
import soles.*
import movimientos.*
import proyectil.*

describe "Comportamiento de las plantas" {

    test "El girasol produce un sol al actuar" {
        const posicion = game.at(4, 1)
        const girasol = cartaGirasol.crearPlanta(posicion)

        girasol.actuar()

        assert.that(patio.haySolEnCasilla(posicion))
        patio.solEnCasilla(posicion).desaparecer()
    }

    test "El lanzaguisantes crea un proyectil si hay un zombie delante" {
        const lanzaguisantes = cartaLanzaguisantes.crearPlanta(game.at(4, 2))
        const zombie = new Mono(position = game.at(6, 2))
        const cantidadProyectilesAntes = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
            .size()
        patio.agregarZoombie(zombie)

        lanzaguisantes.actuar()

        const proyectiles = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
        assert.equals(cantidadProyectilesAntes + 1, proyectiles.size())

        proyectiles.forEach({ proyectil => proyectil.desaparecer() })
        patio.quitarZoombie(zombie)
    }

    test "El proyectil impacta al zombie antes de desaparecer en el borde" {
        const lanzaguisantes = cartaLanzaguisantes.crearPlanta(game.at(10, 2))
        const zombie = new Mono(position = game.at(11, 2), vida = 30)
        const proyectil = new Proyectil(
            position = lanzaguisantes.position(),
            plantaQueLoDispara = lanzaguisantes
        )
        patio.agregarZoombie(zombie)
        patio.agregarProyectil(proyectil)
        proyectil.aparecer()

        proyectil.actuar()

        assert.notThat(zombie.estaVivo())
        assert.notThat(game.hasVisual(proyectil))
    }

    test "El proyectil que llega al borde sin impactar se elimina del patio" {
        const lanzaguisantes = cartaLanzaguisantes.crearPlanta(game.at(10, 2))
        const cantidadProyectilesAntes = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
            .size()
        const proyectil = new Proyectil(
            position = lanzaguisantes.position(),
            plantaQueLoDispara = lanzaguisantes
        )
        patio.agregarProyectil(proyectil)
        proyectil.aparecer()

        proyectil.actuar()

        const cantidadProyectilesDespues = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
            .size()
        assert.equals(cantidadProyectilesAntes, cantidadProyectilesDespues)
        assert.notThat(game.hasVisual(proyectil))
    }

    test "BonkChoi daña al zombie en la casilla de adelante" {
        const bonkChoi = new BonkChoi(position = game.at(4, 3))
        const zombie = new Mono(position = game.at(5, 3), vida = 30)
        patio.agregarZoombie(zombie)

        bonkChoi.actuar()

        assert.notThat(zombie.estaVivo())
        patio.quitarZoombie(zombie)
    }

    test "La nuez pierde vida al recibir daño y sigue viva si le queda vida" {
        const nuez = cartaNuez.crearPlanta(game.at(4, 4))

        nuez.recibirDaño(1000)

        assert.that(nuez.estaVivo())

        nuez.recibirDaño(3000)

        assert.notThat(nuez.estaVivo())
    }


    test "El jugador delega accionar a la herramienta equipada" {
        const posicionOriginal = jugador.position()
        const posicion = game.at(4, 5)
        jugador.position(posicion)

        const nuez = cartaNuez.crearPlanta(posicion)
        patio.agregarPlanta(nuez)
        jugador.equipar(pala)
        jugador.accionar()

        assert.notThat(patio.hayPlantaEnCasilla(posicion))

        const solesAntes = contadorDeSoles.cantidad()
        const sol = new Sol(position = posicion)
        patio.agregarSol(sol)
        sol.aparecer()
        jugador.equipar(cursor)
        jugador.accionar()

        assert.notThat(patio.haySolEnCasilla(posicion))
        assert.equals(solesAntes + 25, contadorDeSoles.cantidad())

        jugador.equipar(cursor)
        jugador.position(posicionOriginal)
    }

    test "El lanzaguisantes no dispara si no hay zombies delante" {
        const lanzaguisantes = cartaLanzaguisantes.crearPlanta(game.at(4, 2))
        const cantidadProyectilesAntes = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
            .size()

        lanzaguisantes.actuar()

        const cantidadProyectilesDespues = patio.entidades()
            .filter({ entidad => entidad.image() == "guisante.png" })
            .size()
        assert.equals(cantidadProyectilesAntes, cantidadProyectilesDespues)
    }

    test "La planta carnivora devora en su casilla y empieza a masticar" {
        const posicion = game.at(4, 3)
        const carnivora = new PlantaCarnivora(position = posicion)
        const zombie = new Mono(position = posicion, vida = 30)
        patio.agregarZoombie(zombie)

        carnivora.actuar()

        assert.notThat(zombie.estaVivo())
        assert.equals("plantaCarnivoraMasticando.png", carnivora.image())

        carnivora.cambiarEstado(carnivoraLista, 500)
        patio.quitarZoombie(zombie)
    }

    test "El proyectil avanza una casilla mientras no encuentre un objetivo" {
        const lanzaguisantes = cartaLanzaguisantes.crearPlanta(game.at(4, 2))
        const posicionInicial = lanzaguisantes.position()
        const proyectil = new Proyectil(
            position = posicionInicial,
            plantaQueLoDispara = lanzaguisantes
        )
        patio.agregarProyectil(proyectil)
        proyectil.aparecer()

        proyectil.actuar()

        assert.equals(game.at(5, 2), proyectil.position())

        proyectil.desaparecer()
    }
}
import plantas.*
import jugador.*
import wollok.game.*


describe "Tests de Planta" {

  test "Una planta con vida mayor a 0 esta viva" {
    const planta = new Planta(
      position = game.at(1, 1),
      vida = 100,
      costeDeSoles = 50,
      tiempoDeRecarga = 5,
      daño = 0,
      tipoDeAtaque = object { method ejecutar(p, z) {} }
    )
    assert.that(planta.estaVivo())
  }

  test "Una planta con vida igual o menor a 0 no esta viva" {
    const planta = new Planta(
      position = game.at(1, 1),
      vida = 0,
      costeDeSoles = 50,
      tiempoDeRecarga = 5,
      daño = 0,
      tipoDeAtaque = object { method ejecutar(p, z) {} }
    )
    assert.notThat(planta.estaVivo())
  }

  test "Un zombie dentro de 3 casilleros esta en rango" {
    const planta = new Planta(
      position = game.at(1, 1),
      vida = 100,
      costeDeSoles = 50,
      tiempoDeRecarga = 5,
      daño = 0,
      tipoDeAtaque = object { method ejecutar(p, z) {} }
    )
    
    // Creamos un objeto zombie anónimo local
    const zombieCerca = object {
      method posicion() = game.at(3, 1)
    }

    assert.that(planta.estaEnSuRango(zombieCerca))
  }

  test "Un zombie fuera de la misma fila no esta en rango" {
    const planta = new Planta(
      position = game.at(1, 1),
      vida = 100,
      costeDeSoles = 50,
      tiempoDeRecarga = 5,
      daño = 0,
      tipoDeAtaque = object { method ejecutar(p, z) {} }
    )

    const zombieOtraFila = object {
      method posicion() = game.at(3, 2)
    }

    assert.notThat(planta.estaEnSuRango(zombieOtraFila))
  }
}

describe "Test de cursor" {
  
  test "prueba de cursor" {
    assert.equals("cursor.png", cursor.image())
  }
}
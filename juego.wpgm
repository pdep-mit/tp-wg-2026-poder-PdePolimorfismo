import wollok.game.*
import soles.*
import cursor.*
import movimientos.*
import patio.*
import podadoras.*
import jugador.*
import pala.*
import sonidos.*
import estadoDelJuego.*
import cartaPlanta.*
import nivel.*
import zoombie.*

object juego {
	method iniciarJuego() {
		self.configurarVentana()
		self.crearPodadoras()
		self.configurarInterfaz()
		self.configurarControles()
		
		generadorDeSoles.programarLluviaDeSoles()
		directorDeOleadas.iniciar()
		game.onTick(400, "relojJuego", { patio.pasarTiempo(400) })
		
		game.start()
	}

	method configurarVentana() {
		game.title("Plantas vs Zoombies")
		game.cellSize(120)
		game.height(7)
		game.width(12)
		game.boardGround("escenarioDia.jpg")
	}

	method crearPodadoras() {
		(1 .. game.height() - 2).forEach({ fila =>
			const podar = new Podadora(position = game.at(2, fila))
			patio.agregarPodadora(podar)
			podar.aparecer()
		})
	}

	method configurarInterfaz() {
		[cartaGirasol, cartaLanzaguisantes, cartaNuez, cartaBonkChoi, cartaCereza, cartaPlantaCarnivora]
			.forEach({ carta => game.addVisual(carta) })
		game.addVisual(jugador)
		game.addVisual(contadorDeSoles)
		game.addVisual(indicadorDeOleada)
	}

	method configurarControles() {
		keyboard.right().onPressDo({ jugador.moverse(derecha) })
		keyboard.left().onPressDo({ jugador.moverse(izquierda) })
		keyboard.up().onPressDo({ jugador.moverse(arriba) })
		keyboard.down().onPressDo({ jugador.moverse(abajo) })
		
		keyboard.num1().onPressDo({ finDelJuego.plantar(cartaGirasol) })
		keyboard.num2().onPressDo({ finDelJuego.plantar(cartaLanzaguisantes) })
		keyboard.num3().onPressDo({ finDelJuego.plantar(cartaNuez) })
		keyboard.num4().onPressDo({ finDelJuego.plantar(cartaBonkChoi) })
		keyboard.num5().onPressDo({ finDelJuego.plantar(cartaCereza) })
		keyboard.num6().onPressDo({ finDelJuego.plantar(cartaPlantaCarnivora)})
		
		keyboard.p().onPressDo({ finDelJuego.equipar(pala) })
		keyboard.c().onPressDo({ finDelJuego.equipar(cursor) })
		
		keyboard.space().onPressDo({ jugador.accionar() })

	}
}

program principal {
	juego.iniciarJuego()
}
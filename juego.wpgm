import wollok.game.*
import soles.*
import cursor.*
import movimientos.*
import patio.*
import podadoras.*
import plantas.*
import jugador.*
import pala.*

class Casilla {
    var property position
    method image() = "casillaDia.png" 
}

object juego {
	const musicaFondo = game.sound("soundtrack.mp3")

	method iniciarJuego() {

    game.title("PLantas vs Zoombies")
    game.cellSize(120)
    game.height(7)
    game.width(12)
    game.boardGround("escenarioDia.png")

    (4 .. game.width() - 1).forEach({ x =>
            (1 .. game.height() - 2).forEach({ y =>
                game.addVisual(new Casilla(position = game.at(x, y)))
            })
        })
		
	musicaFondo.shouldLoop(true)
    musicaFondo.volume(0.2)
    musicaFondo.play()

    game.addVisual(jugador)
    game.addVisual(contadorDeSoles)   

	game.onTick(10000, "lluviaDeSoles", { generadorDeSoles.generarSolAleatorio() })
    game.onTick(1500, "movimientoSoles", { 
    	patio.soles().forEach({ sol => sol.actuar() }) 
})

    /*game.onTick( 15000, "crearZoombie", {
        const tipos = [new Mono(), new Pinguino(), new Jirafa(), new Oso(), new Rinoceronte(), new Buitre()]
        const elegido = tipos.anyOne()
        elegido.aparecer()
    })
    */

	(1..5).forEach({fila => const podar = new Podadora(position = game.at(3, fila))
     podar.aparecer()
     podar.actuar()})

		
	keyboard.right().onPressDo({ jugador.moverse(derecha)}) // movilidad del cursor
	keyboard.left().onPressDo({ jugador.moverse(izquierda)})		
    keyboard.up().onPressDo({ jugador.moverse(arriba)})
	keyboard.down().onPressDo({ jugador.moverse(abajo)})

	keyboard.num1().onPressDo({ jugador.plantar(new Girasol()) })
    keyboard.num2().onPressDo({ jugador.plantar(new Lanzaguisantes()) })

    keyboard.num4().onPressDo({ jugador.plantar(new BonkChoi()) })

    keyboard.p().onPressDo({ jugador.equipar(pala) }) 
    keyboard.c().onPressDo({ jugador.equipar(cursor) })

    keyboard.x().onPressDo({ jugador.remover() })

	keyboard.space().onPressDo({ jugador.recolectarSol()})

	game.start()

	}
}

program principal {
	juego.iniciarJuego()
}

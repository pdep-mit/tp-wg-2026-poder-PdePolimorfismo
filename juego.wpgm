import movimientos.*
import jugador.*
import wollok.game.*
import plantas.*
import zoombie.*
import ataques.*
import soles.*
import podadora.*

object juego {
	const musicaFondo = game.sound("soundtrack.mp3")

	method iniciarJuego() {

    game.title("PLantas vs Zoombies")
    game.cellSize(120)
    game.height(6)
    game.width(12)
    game.boardGround("escenario.png")
		
	musicaFondo.shouldLoop(true)
    musicaFondo.volume(0.2)
    musicaFondo.play()

	generadorDeSoles.iniciar()
    game.onTick( 15000, "crearZoombie", {
        const tipos = [new Mono(), new Pinguino(), new Jirafa(), new Oso(), new Rinoceronte(), new Buitre()]
        const elegido = tipos.anyOne()
        elegido.aparecer()
    })
    game.addVisual(contadorDeSoles)
    game.addVisual(cursor)

	(0..4).forEach({fila => const podar = new Podadora(position = game.at(3, fila)); game.addVisual(podar); podar.hazTuMagia()})

		
	keyboard.right().onPressDo({ cursor.mover(derecha)}) // movilidad del cursor
	keyboard.left().onPressDo({ cursor.mover(izquierda)})		
    keyboard.up().onPressDo({ cursor.mover(arriba)})
	keyboard.down().onPressDo({ cursor.mover(abajo)})
	keyboard.num1().onPressDo({ cursor.plantar(controlGirasol) })
    keyboard.num2().onPressDo({ cursor.plantar(controlLanzaGuisantes) })
    keyboard.num3().onPressDo({ cursor.plantar(controlNuez) })
    keyboard.num4().onPressDo({ cursor.plantar(controlBonkChoi) })
    keyboard.num5().onPressDo({ cursor.plantar(controlCereza) })
    keyboard.num6().onPressDo({ cursor.plantar(controlCarnivora) })
	keyboard.space().onPressDo({ cursor.recolectarSol()})

    game.onTick(200, "actualizarSoles", {game.say(contadorDeSoles, "Soles: " + contadorDeSoles.solesAhora())})   // con esto podemos hacer que aparezca en pantalla la cantidad de soles   
    

	game.start()

	}

}

program principal {
	juego.iniciarJuego()
}

import wollok.game.*
import soles.*
import cursor.*
import movimientos.*
import patio.*
import podadoras.*
import planta.*
import zoombie.*
import jugador.*
import pala.*
import abstracciones.*

class Casilla {
  var property position
  
  method image() = "casillaDia.png"
}

object juego {
  const musicaFondo = game.sound("musica.wav")
  
  method iniciarJuego() {
    game.title("PLantas vs Zoombies")
    game.cellSize(120)
    game.height(7)
    game.width(12)
    game.boardGround("escenarioDia.png")
    
    (4 .. (game.width() - 1)).forEach(
      { x => (1 .. (game.height() - 2)).forEach(
          { y => game.addVisual(new Casilla(position = game.at(x, y))) }
        ) }
    )
    
    musicaFondo.shouldLoop(true)
    musicaFondo.volume(0.2)
    musicaFondo.play()
    
    game.addVisual(jugador)
    game.addVisual(contadorDeSoles)

    game.onTick(
    2000, 
    "actuarPlantas", 
    { patio.plantas().forEach({ planta => planta.actuar() }) }
)
    
    generadorDeSoles.programarLluviaDeSoles()

    game.onTick(
      1500,
      "movimientoSoles",
      { patio.soles().forEach({ sol => sol.actuar() }) }
    )
    generarZoombis.programarAparicion()
    
    game.onTick(
      3000,
      "moverZombies",
      { patio.zoombies().forEach({ zoombie => zoombie.actuar() }) }
    )
    game.onTick(
      200,
      "moverPodadoras",
      { patio.podadoras().forEach({ podadora => podadora.actuar() }) }
    )

    game.onTick(
      100,
      "moverProyectiles", 
      { patio.proyectiles().forEach({ proyectil => proyectil.actuar() }) }
    )
    
    
  (1 .. game.height() - 2).forEach({ fila =>
	  const podar = new Podadora(position = game.at(3, fila))
	  patio.agregarPodadora(podar)
	  podar.aparecer()
  })
    
    
    keyboard.right().onPressDo({ jugador.moverse(derecha) })
    // movilidad del cursor
    keyboard.left().onPressDo({ jugador.moverse(izquierda) })
    keyboard.up().onPressDo({ jugador.moverse(arriba) })
    keyboard.down().onPressDo({ jugador.moverse(abajo) })
    
    keyboard.num1().onPressDo({ jugador.plantar(new Girasol()) })
    keyboard.num2().onPressDo({ jugador.plantar(new Lanzaguisantes()) })
    
    keyboard.num4().onPressDo({ jugador.plantar(new BonkChoi()) })
    
    keyboard.p().onPressDo({ jugador.equipar(pala) })
    keyboard.c().onPressDo({ jugador.equipar(cursor) })
    
    keyboard.space().onPressDo({ jugador.accionar() })
    
    game.start()
  }
}

program principal {
  juego.iniciarJuego()
}